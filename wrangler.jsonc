{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ttrpg",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ttrpg",
      "database_id": "98069deb-990a-4a56-b963-3c3b68689e68",
      "migrations_dir": "src/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ttrpg-files-live-bolt-x2t3543ef7xmukte",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "WORLDS", "class_name": "WorldDO" }],
  },
  "exports": {
    "WorldDO": { "type": "durable-object", "storage": "sqlite" },
  },
  "env": {
    "preview": {
      "name": "ttrpg-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ttrpg-preview",
          "database_id": "c10f3cbe-b6f3-4174-b714-84a4671df70f",
          "migrations_dir": "src/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "ttrpg-files-preview",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "WORLDS", "class_name": "WorldDO" }],
      },
      "exports": {
        "WorldDO": { "type": "durable-object", "storage": "sqlite" },
      },
    },
  },
}
