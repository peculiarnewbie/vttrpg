// Local-only corpus integration. Production remains unbound until corpus deploys.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ttrpg",
  "main": "../../src/worker.ts",
  "compatibility_date": "2026-03-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [],
  "vars": { "FLAGS": "corpus" },
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ttrpg",
      "database_id": "98069deb-990a-4a56-b963-3c3b68689e68",
      "migrations_dir": "../../src/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "ttrpg-files-live-bolt-x2t3543ef7xmukte" },
    { "binding": "CORPUS_BUCKET", "bucket_name": "ttrpg-corpus-files" },
  ],
  "services": [
    { "binding": "CORPUS", "service": "ttrpg-corpus", "entrypoint": "CorpusEntrypoint" },
  ],
  "durable_objects": { "bindings": [{ "name": "WORLDS", "class_name": "WorldDO" }] },
  "exports": { "WorldDO": { "type": "durable-object", "storage": "sqlite" } },
}
