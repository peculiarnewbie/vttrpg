{
  "name": "ttrpg",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "deploy": "pnpm build && pnpm deploy:production",
    "deploy:production": "wrangler deploy --env=\"\"",
    "deploy:preview": "wrangler deploy --env preview",
    "dev": "pnpm db:migrate:local && pnpm build && wrangler dev --env=\"\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env=\"\"",
    "db:migrate": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "db:generate": "drizzle-kit generate",
    "types": "wrangler types",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "0.0.12",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.23",
    "@solidjs/web": "2.0.0-rc.7",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/virtual-core": "^3.17.9",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.112",
    "solid-js": "2.0.0-rc.7"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.0",
    "@types/node": "^26.6.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.28.1",
    "jsdom": "^30.0.1",
    "miniflare": "5.20260908.0-alpha",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plugin-solid": "3.0.0-next.27",
    "vite-plus": "^0.3.1",
    "vitest": "4.1.11",
    "wrangler": "^4.130.0"
  },
  "packageManager": "pnpm@12.4.2"
}
