{
  "name": "ttrpg",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "deploy": "vp build && vp exec alchemy deploy",
    "destroy": "vp exec alchemy destroy",
    "plan": "vp exec alchemy plan",
    "dev": "vp build && vp exec alchemy dev",
    "db:migrate": "wrangler d1 migrations apply ttrpg --remote",
    "db:generate": "drizzle-kit generate",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.23",
    "@solidjs/web": "2.0.0-rc.7",
    "@stylexjs/stylex": "^0.19.0",
    "alchemy": "2.0.0-beta.77",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.112",
    "solid-js": "2.0.0-rc.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@stylexjs/unplugin": "^0.19.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plugin-solid": "3.0.0-next.27",
    "vite-plus": "^0.3.1",
    "vitest": "4.1.11",
    "wrangler": "^4.130.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@0.3.1",
      "vitest@*": "4.1.11",
      "@effect/platform-node-shared": "4.0.0-rc.112",
      "@effect/vitest": "4.0.0-rc.112",
      "@effect/sql-d1": "4.0.0-rc.112",
      "@effect/sql-sqlite-do": "4.0.0-rc.112"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
