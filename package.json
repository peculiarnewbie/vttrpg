{
  "name": "web-template",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "vp exec alchemy deploy",
    "destroy": "vp exec alchemy destroy",
    "plan": "vp exec alchemy plan",
    "dev": "vp exec alchemy dev",
    "db:migrate": "wrangler d1 migrations apply web-template --remote",
    "db:generate": "drizzle-kit generate",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "typecheck": "tsgo --noEmit",
    "styles": "npx tokenami --output ./src/styles.css",
    "styles:watch": "npx tokenami --output ./src/styles.css --watch"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@effect/platform-bun": "4.0.0-rc.113",
    "@effect/platform-node": "4.0.0-rc.113",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.23",
    "@solidjs/web": "2.0.0-rc.7",
    "@tokenami/css": "^0.0.102",
    "alchemy": "2.0.0-beta.77",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.113",
    "solid-js": "2.0.0-rc.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@tokenami/unplugin": "^0.0.102",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "tokenami": "^0.0.102",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plugin-solid": "3.0.0-next.27",
    "vite-plus": "^0.3.1",
    "wrangler": "^4.130.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@0.3.1",
      "vitest@*": "4.1.11"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
